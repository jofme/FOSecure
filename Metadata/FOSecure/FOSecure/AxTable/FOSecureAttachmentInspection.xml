		<Methods>
			<Method>
				<Name>findByFileId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the recorded inspection for a stored file.
    /// </summary>
    /// <param name = "_fileId">The DocuValue file identifier.</param>
    /// <param name = "_forUpdate">Whether the row is about to be written.</param>
    /// <returns>The row, or an empty buffer.</returns>
    public static FOSecureAttachmentInspection findByFileId(guid _fileId, boolean _forUpdate = false)
    {
        FOSecureAttachmentInspection inspection;

        if (_fileId == emptyGuid())
        {
            return inspection;
        }

        inspection.selectForUpdate(_forUpdate);

        select firstonly inspection
            where inspection.FileId == _fileId;

        return inspection;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findCurrentByFileId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the recorded inspection only when it was produced by current detection logic.
    /// </summary>
    /// <param name = "_fileId">The DocuValue file identifier.</param>
    /// <param name = "_inspectorVersion">The version the caller considers current.</param>
    /// <returns>The row, or an empty buffer when there is none or it is out of date.</returns>
    public static FOSecureAttachmentInspection findCurrentByFileId(guid _fileId, int _inspectorVersion)
    {
        FOSecureAttachmentInspection inspection = FOSecureAttachmentInspection::findByFileId(_fileId);

        if (inspection.RecId && inspection.InspectorVersion >= _inspectorVersion)
        {
            return inspection;
        }

        inspection.clear();

        return inspection;
    }

]]></Source>
			</Method>
			<Method>
				<Name>existsForFileId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Determines whether a stored file has ever been inspected.
    /// </summary>
    /// <param name = "_fileId">The DocuValue file identifier.</param>
    /// <returns>true when a row exists, whatever version produced it.</returns>
    public static boolean existsForFileId(guid _fileId)
    {
        FOSecureAttachmentInspection inspection;

        if (_fileId == emptyGuid())
        {
            return false;
        }

        select firstonly RecId from inspection
            where inspection.FileId == _fileId;

        return inspection.RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>activeContentDescription</Name>
				<Source><![CDATA[
    /// <summary>
    /// The recorded findings, as text in the reader's language.
    /// </summary>
    /// <returns>A readable list, or an empty string.</returns>
    public display FOSecureFindingDetail activeContentDescription()
    {
        str remaining = this.FindingLabels;
        str result;
        str labelId;
        int separator;

        while (remaining)
        {
            separator = strScan(remaining, ',', 1, strLen(remaining));

            if (separator > 0)
            {
                labelId   = subStr(remaining, 1, separator - 1);
                remaining = subStr(remaining, separator + 1, strLen(remaining) - separator);
            }
            else
            {
                labelId   = remaining;
                remaining = '';
            }

            if (labelId)
            {
                result += (result ? ', ' : '') + SysLabel::labelId2String2(labelId);
            }
        }

        return result;
    }

]]></Source>
			</Method>
