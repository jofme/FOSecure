]]></Declaration>
		<Methods>
			<Method>
				<Name>findByFileId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the malware scan row for a stored file.
    /// </summary>
    /// <param name = "_fileId">The DocuValue file identifier the row is keyed on.</param>
    /// <param name = "_forUpdate">Whether to select the record for update.</param>
    /// <returns>The scan row, or an empty buffer when the file has never been submitted.</returns>
    public static FOSecureAttachmentScan findByFileId(guid _fileId, boolean _forUpdate = false)
    {
        FOSecureAttachmentScan attachmentScan;

        if (_fileId == emptyGuid())
        {
            return attachmentScan;
        }

        attachmentScan.selectForUpdate(_forUpdate);

        select firstonly attachmentScan
            where attachmentScan.FileId == _fileId;

        return attachmentScan;
    }

]]></Source>
			</Method>
			<Method>
				<Name>existsForFileId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Determines whether a stored file has already been submitted for scanning.
    /// </summary>
    /// <param name = "_fileId">The DocuValue file identifier.</param>
    /// <returns>true when a scan row exists for the file.</returns>
    public static boolean existsForFileId(guid _fileId)
    {
        FOSecureAttachmentScan attachmentScan;

        if (_fileId == emptyGuid())
        {
            return false;
        }

        select firstonly RecId from attachmentScan
            where attachmentScan.FileId == _fileId;

        return attachmentScan.RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>needsSubmission</Name>
				<Source><![CDATA[
    /// <summary>
    /// Whether this file still has to reach the quarantine container.
    /// </summary>
    /// <returns>true when nothing has been submitted for it yet.</returns>
    /// <remarks>
    /// A row whose content never reached the container records the attempt, not a verdict, so it
    /// must not stand in the way of scanning the file the next time it is used.
    /// </remarks>
    public boolean needsSubmission()
    {
        if (!this.RecId)
        {
            return true;
        }

        if (this.BlobName)
        {
            return false;
        }

        switch (this.ScanState)
        {
            case FOSecureMalwareScanState::NotScanned:
            case FOSecureMalwareScanState::Unavailable:
                return true;
        }

        return false;
    }

]]></Source>
			</Method>
