/// <summary>
/// Inflates deflate compressed content under hard output limits.
/// </summary>
public final class FOSecureDeflate
{
    private const int ChunkBytes = 65536;
    private const int MaxInflatedPerStream = 8388608;
    private const int MaxRatio = 1000;
    private const int RatioFloor = 1048576;
    private const int ZlibDeflateMethod = 8;
    private const int MaxWindowBits = 7;
    private const int FdictFlag = 32;

    /// <summary>Mask selecting the compression method nibble of the zlib header.</summary>
    private const int MethodMask = 15;

    /// <summary>Shift moving the window size nibble of the zlib header into place.</summary>
    private const int WindowBitsShift = 4;

    /// <summary>A valid zlib header read as a 16 bit value is a multiple of this.</summary>
    private const int FcheckModulus = 31;
    private const int ResultText = 1;
    private const int ResultTruncated = 2;
    private const int ResultSucceeded = 3;

    /// <summary>
    /// How many bytes of zlib wrapper sit in front of the deflate data.
    /// </summary>
    /// <param name = "_firstByte">First byte of the stream, or -1.</param>
    /// <param name = "_secondByte">Second byte of the stream, or -1.</param>
    /// <returns>2 for a zlib header, 0 for raw deflate, -1 when it cannot be inflated.</returns>
    public static int zlibHeaderLength(int _firstByte, int _secondByte)
    {
        if (_firstByte < 0 || _secondByte < 0)
        {
            return FOSecureContentConstants::NotFound;
        }

        if ((_firstByte & FOSecureDeflate::MethodMask) != FOSecureDeflate::ZlibDeflateMethod
            || (_firstByte >> FOSecureDeflate::WindowBitsShift) > FOSecureDeflate::MaxWindowBits)
        {
            return 0;
        }

        if (((_firstByte * FOSecureContentConstants::ByteValues + _secondByte)
            mod FOSecureDeflate::FcheckModulus) != 0)
        {
            return 0;
        }

        if ((_secondByte & FOSecureDeflate::FdictFlag) != 0)
        {
            return FOSecureContentConstants::NotFound;
        }

        return 2;
    }

    /// <summary>
    /// Inflates raw deflate data.
    /// </summary>
    /// <param name = "_compressed">The data, with any zlib header already removed.</param>
    /// <param name = "_compressedLength">How many bytes are meaningful.</param>
    /// <param name = "_maxOutputBytes">The output ceiling for this stream.</param>
    /// <returns>A container of inflated text, truncated flag, succeeded flag.</returns>
    public static container inflate(
        System.Byte[] _compressed,
        int           _compressedLength,
        int           _maxOutputBytes = FOSecureDeflate::MaxInflatedPerStream)
    {
        System.IO.MemoryStream    source;
        System.Byte[]             chunk;
        System.Text.Encoding      latin1;
        System.Text.StringBuilder builder;
        int                       read;
        int                       total;
        int                       budget;
        boolean                   wasTruncated;
        boolean                   ok;

        if (_compressed == null || _compressedLength <= 0)
        {
            return ['', false, false];
        }

        budget = _maxOutputBytes > 0 && _maxOutputBytes < FOSecureDeflate::MaxInflatedPerStream
            ? _maxOutputBytes
            : FOSecureDeflate::MaxInflatedPerStream;

        try
        {
            latin1  = System.Text.Encoding::GetEncoding(FOSecureContentConstants::Latin1CodePage);
            builder = new System.Text.StringBuilder();
            source  = new System.IO.MemoryStream(_compressed, 0, _compressedLength, false);
            chunk   = new System.Byte[FOSecureDeflate::ChunkBytes]();

            using (System.IO.Compression.DeflateStream inflater = new System.IO.Compression.DeflateStream(
                source,
                System.IO.Compression.CompressionMode::Decompress,
                false))
            {
                read = inflater.Read(chunk, 0, FOSecureDeflate::ChunkBytes);

                while (read > 0)
                {
                    if (total + read > budget
                        || (total > FOSecureDeflate::RatioFloor
                        && (total div _compressedLength) > FOSecureDeflate::MaxRatio))
                    {
                        wasTruncated = true;
                        break;
                    }

                    total += read;
                    builder.Append(latin1.GetString(chunk, 0, read));

                    read = inflater.Read(chunk, 0, FOSecureDeflate::ChunkBytes);
                }

                ok = true;
            }

            return [builder.ToString(), wasTruncated, ok];
        }
        catch (Exception::CLRError)
        {
            // Corrupt, encrypted, or a guessed stream boundary that was wrong. Fail open.
            exceptionTextFallThrough();
        }
        catch (Exception::Error)
        {
            exceptionTextFallThrough();
        }

        return ['', false, false];
    }

    /// <summary>
    /// The inflated text from a result.
    /// </summary>
    /// <param name = "_result">A result from inflate().</param>
    /// <returns>The text, or an empty string.</returns>
    public static str textOf(container _result)
    {
        return conLen(_result) >= FOSecureDeflate::ResultText
            ? conPeek(_result, FOSecureDeflate::ResultText)
            : '';
    }

    /// <summary>
    /// Whether a limit stopped the inflation early.
    /// </summary>
    /// <param name = "_result">A result from inflate().</param>
    /// <returns>true when output was cut short.</returns>
    public static boolean truncated(container _result)
    {
        return conLen(_result) >= FOSecureDeflate::ResultTruncated
            ? conPeek(_result, FOSecureDeflate::ResultTruncated)
            : false;
    }

    /// <summary>
    /// Whether the data could be inflated at all.
    /// </summary>
    /// <param name = "_result">A result from inflate().</param>
    /// <returns>false when the data was not readable as deflate.</returns>
    public static boolean succeeded(container _result)
    {
        return conLen(_result) >= FOSecureDeflate::ResultSucceeded
            ? conPeek(_result, FOSecureDeflate::ResultSucceeded)
            : false;
    }

}