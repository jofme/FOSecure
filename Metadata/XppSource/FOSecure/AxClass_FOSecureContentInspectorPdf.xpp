/// <summary>
/// Confirms a PDF and reports the active content it carries.
/// </summary>
public final class FOSecureContentInspectorPdf extends FOSecureContentInspector
{
    private const int MaxTokenScanChars = 4194304;
    private const int MaxStreams = 512;
    private const int MaxEscapedNames = 4096;
    private const int MaxNameChars = 127;
    private const int DictionaryLookBack = 512;
    private const int MaxInflatedStreams = 64;
    private const int MaxInflatedPerFile = 33554432;
    private const int HeaderMarkerLength = 5;
    private const int HeaderOffsetTolerance = 4;
    private const int StreamKeywordLength = 6;
    private const int EndStreamKeywordLength = 9;
    private const int EndPrefixLength = 3;

    /// <summary>
    /// Whether a character code ends a name object.
    /// </summary>
    /// <param name = "_code">The character code, or 0 for end of text.</param>
    /// <returns>true for whitespace, a delimiter, or the end of content.</returns>
    private static boolean isNameTerminator(int _code)
    {
        if (_code <= 0 || FOSecureContentWindow::isSpace(_code))
        {
            return true;
        }

        return _code == FOSecureContentConstants::LeftParenthesis
            || _code == FOSecureContentConstants::RightParenthesis
            || _code == FOSecureContentConstants::LessThan
            || _code == FOSecureContentConstants::GreaterThan
            || _code == FOSecureContentConstants::LeftBracket
            || _code == FOSecureContentConstants::RightBracket
            || _code == FOSecureContentConstants::LeftBrace
            || _code == FOSecureContentConstants::RightBrace
            || _code == FOSecureContentConstants::Solidus
            || _code == FOSecureContentConstants::Percent;
    }

    /// <summary>
    /// Whether a character code may appear inside a name object.
    /// </summary>
    /// <param name = "_code">The character code.</param>
    /// <returns>true for a regular name character.</returns>
    private static boolean isNameRegular(int _code)
    {
        return _code > FOSecureContentConstants::PrintableMin
            && _code < FOSecureContentConstants::PrintableMax
            && !FOSecureContentInspectorPdf::isNameTerminator(_code);
    }

    /// <summary>
    /// The name objects worth reporting.
    /// </summary>
    /// <returns>The tokens, spelled as the specification does.</returns>
    private static container riskyTokens()
    {
        return ['/JavaScript', '/JS', '/Launch', '/RichMedia', '/EmbeddedFile',
            '/OpenAction', '/AA', '/XFA', '/SubmitForm', '/GoToR', '/ImportData'];
    }

    /// <summary>
    /// What sort of active content a token represents.
    /// </summary>
    /// <param name = "_token">A token from riskyTokens.</param>
    /// <returns>The kind the policy rates.</returns>
    private static FOSecureActiveContentKind kindOfToken(str _token)
    {
        switch (_token)
        {
            case '/JavaScript':
            case '/JS':
                return FOSecureActiveContentKind::Script;

            case '/Launch':
            case '/RichMedia':
                return FOSecureActiveContentKind::DynamicMedia;

            case '/EmbeddedFile':
                return FOSecureActiveContentKind::EmbeddedFile;

            case '/OpenAction':
            case '/AA':
                return FOSecureActiveContentKind::AutoAction;

            case '/XFA':
            case '/SubmitForm':
                return FOSecureActiveContentKind::InteractiveForm;

            case '/GoToR':
            case '/ImportData':
                return FOSecureActiveContentKind::ExternalReference;
        }

        return FOSecureActiveContentKind::None;
    }

    /// <summary>
    /// The evidence label for a token.
    /// </summary>
    /// <param name = "_token">A token from riskyTokens.</param>
    /// <returns>A label id, unresolved.</returns>
    private static str labelOfToken(str _token)
    {
        switch (_token)
        {
            case '/JavaScript':
            case '/JS':
                return FOSecureContentConstants::PdfJavaScriptEvidence;

            case '/Launch':
                return FOSecureContentConstants::PdfLaunchEvidence;

            case '/RichMedia':
                return FOSecureContentConstants::PdfRichMediaEvidence;

            case '/EmbeddedFile':
                return FOSecureContentConstants::PdfEmbeddedFileEvidence;

            case '/OpenAction':
            case '/AA':
                return FOSecureContentConstants::PdfOpenActionEvidence;

            case '/XFA':
                return FOSecureContentConstants::PdfXfaEvidence;

            case '/SubmitForm':
                return FOSecureContentConstants::PdfSubmitFormEvidence;

            case '/GoToR':
                return FOSecureContentConstants::PdfRemoteGoToEvidence;

            case '/ImportData':
                return FOSecureContentConstants::PdfImportDataEvidence;
        }

        return '';
    }

    /// <summary>
    /// Finds where the PDF header starts.
    /// </summary>
    /// <param name = "_text">The leading content.</param>
    /// <returns>The zero based byte offset, or -1.</returns>
    public static int headerOffset(str _text)
    {
        int limit = strLen(_text) < FOSecureContentConstants::HeaderSearchWindow
            ? strLen(_text)
            : FOSecureContentConstants::HeaderSearchWindow;
        str window = subStr(_text, 1, limit);
        int found  = FOSecureContentWindow::indexOfOrdinalOneBased(window, '%PDF-', 1, true);
        int major;
        int minor;

        while (found > 0)
        {
            major = found + FOSecureContentInspectorPdf::HeaderMarkerLength;
            minor = major + 2;

            if (minor <= limit
                && FOSecureContentWindow::isDigit(char2Num(window, major))
                && char2Num(window, major + 1) == FOSecureContentConstants::Dot
                && FOSecureContentWindow::isDigit(char2Num(window, minor)))
            {
                return found - 1;
            }

            found = FOSecureContentWindow::indexOfOrdinalOneBased(window, '%PDF-', found + 1, true);
        }

        return FOSecureContentConstants::NotFound;
    }

    /// <summary>
    /// Locates the stream data regions.
    /// </summary>
    /// <param name = "_text">The content.</param>
    /// <returns>Alternating one based start and end positions.</returns>
    public static container streamRanges(str _text)
    {
        container ranges;
        int       position = 1;
        int       streamAt;
        int       endAt;
        int       streams;

        while (streams < FOSecureContentInspectorPdf::MaxStreams)
        {
            streamAt = FOSecureContentWindow::indexOfOrdinalOneBased(_text, 'stream', position, true);

            if (!streamAt)
            {
                break;
            }

            // The keyword also matches the tail of endstream.
            if (streamAt > FOSecureContentInspectorPdf::EndPrefixLength
                && subStr(_text, streamAt - FOSecureContentInspectorPdf::EndPrefixLength,
                FOSecureContentInspectorPdf::EndPrefixLength) == 'end')
            {
                position = streamAt + FOSecureContentInspectorPdf::StreamKeywordLength;
                continue;
            }

            endAt = FOSecureContentWindow::indexOfOrdinalOneBased(
                _text, 'endstream', streamAt + FOSecureContentInspectorPdf::StreamKeywordLength, true);

            if (!endAt)
            {
                break;
            }

            ranges  += [streamAt, endAt];
            position = endAt + FOSecureContentInspectorPdf::EndStreamKeywordLength;
            streams++;
        }

        return ranges;
    }

    /// <summary>
    /// Whether a position falls inside stream data.
    /// </summary>
    /// <param name = "_ranges">Ranges from streamRanges.</param>
    /// <param name = "_position">A one based position.</param>
    /// <returns>true when inside a stream.</returns>
    private static boolean isInsideStream(container _ranges, int _position)
    {
        int i;

        for (i = 1; i + 1 <= conLen(_ranges); i += 2)
        {
            if (_position >= conPeek(_ranges, i) && _position < conPeek(_ranges, i + 1))
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Reads a name object, decoding its escapes.
    /// </summary>
    /// <param name = "_text">The content.</param>
    /// <param name = "_slashPosition">One based position of the leading solidus.</param>
    /// <returns>The decoded name.</returns>
    private static str decodeNameAt(str _text, int _slashPosition)
    {
        str decoded  = '/';
        int position = _slashPosition + 1;
        int length   = strLen(_text);
        int code;

        while (position <= length && strLen(decoded) < FOSecureContentInspectorPdf::MaxNameChars)
        {
            code = char2Num(_text, position);

            if (code == FOSecureContentConstants::NumberSign && position + 2 <= length
                && FOSecureContentWindow::isHexDigit(char2Num(_text, position + 1))
                && FOSecureContentWindow::isHexDigit(char2Num(_text, position + 2)))
            {
                decoded  += num2Char(hex2Int(subStr(_text, position + 1, 2)));
                position += 3;
                continue;
            }

            if (!FOSecureContentInspectorPdf::isNameRegular(code))
            {
                break;
            }

            decoded += subStr(_text, position, 1);
            position++;
        }

        return decoded;
    }

    /// <summary>
    /// Whether a decoded name is one worth reporting.
    /// </summary>
    /// <param name = "_token">A decoded name.</param>
    /// <returns>true when it is in the risky set.</returns>
    private static boolean isRiskyToken(str _token)
    {
        container tokens = FOSecureContentInspectorPdf::riskyTokens();
        int       i;

        for (i = 1; i <= conLen(tokens); i++)
        {
            if (strCmp(_token, conPeek(tokens, i)) == 0)
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Finds risky names written with escapes.
    /// </summary>
    /// <param name = "_text">The content.</param>
    /// <returns>The decoded names that matter.</returns>
    public static container escapedRiskyTokens(str _text)
    {
        container found;
        int       position = 1;
        int       length   = strLen(_text);
        int       hashAt;
        int       nameStart;
        int       hits;
        str       decoded;

        while (hits < FOSecureContentInspectorPdf::MaxEscapedNames)
        {
            hashAt = FOSecureContentWindow::indexOfOrdinalOneBased(_text, '#', position, true);

            if (!hashAt)
            {
                break;
            }

            position = hashAt + 1;

            if (hashAt + 2 > length
                || !FOSecureContentWindow::isHexDigit(char2Num(_text, hashAt + 1))
                || !FOSecureContentWindow::isHexDigit(char2Num(_text, hashAt + 2)))
            {
                continue;
            }

            hits++;
            nameStart = hashAt - 1;

            while (nameStart >= 1
                && hashAt - nameStart < FOSecureContentInspectorPdf::MaxNameChars
                && FOSecureContentInspectorPdf::isNameRegular(char2Num(_text, nameStart)))
            {
                nameStart--;
            }

            if (nameStart < 1
                || char2Num(_text, nameStart) != FOSecureContentConstants::Solidus)
            {
                continue;
            }

            decoded = FOSecureContentInspectorPdf::decodeNameAt(_text, nameStart);

            if (FOSecureContentInspectorPdf::isRiskyToken(decoded))
            {
                found += [decoded];
            }
        }

        return found;
    }

    /// <summary>
    /// Reports the risky name objects present in some content.
    /// </summary>
    /// <param name = "_text">Raw bytes, or inflated object stream content.</param>
    /// <param name = "_seed">Findings already collected.</param>
    /// <returns>The findings, including those seeded.</returns>
    public static FOSecureContentFindings scanTokens(str _text, FOSecureContentFindings _seed)
    {
        FOSecureContentFindings findings = _seed ? _seed : FOSecureContentFindings::empty();
        container tokens = FOSecureContentInspectorPdf::riskyTokens();
        container ranges = FOSecureContentInspectorPdf::streamRanges(_text);
        container escaped;
        str       token;
        str       evidence;
        int       length = strLen(_text) < FOSecureContentInspectorPdf::MaxTokenScanChars
            ? strLen(_text)
            : FOSecureContentInspectorPdf::MaxTokenScanChars;
        int       i;
        int       at;
        boolean   seen;

        for (i = 1; i <= conLen(tokens); i++)
        {
            token    = conPeek(tokens, i);
            evidence = FOSecureContentInspectorPdf::labelOfToken(token);
            seen     = false;
            at       = FOSecureContentWindow::indexOfOrdinalOneBased(_text, token, 1, true);

            while (at > 0 && at <= length && !seen)
            {
                if (FOSecureContentInspectorPdf::isNameTerminator(char2Num(_text, at + strLen(token)))
                    && !FOSecureContentInspectorPdf::isInsideStream(ranges, at))
                {
                    seen = true;
                }
                else
                {
                    at = FOSecureContentWindow::indexOfOrdinalOneBased(_text, token, at + 1, true);
                }
            }

            if (seen && !findings.contains(evidence))
            {
                findings = findings.with(FOSecureContentFinding::construct(
                    FOSecureContentInspectorPdf::kindOfToken(token), evidence, at - 1));
            }
        }

        escaped = FOSecureContentInspectorPdf::escapedRiskyTokens(_text);

        for (i = 1; i <= conLen(escaped); i++)
        {
            token    = conPeek(escaped, i);
            evidence = FOSecureContentInspectorPdf::labelOfToken(token);

            if (!findings.contains(evidence))
            {
                findings = findings.with(FOSecureContentFinding::construct(
                    FOSecureContentInspectorPdf::kindOfToken(token), evidence));
            }
        }

        return findings;
    }

    /// <summary>
    /// Whether the leading content also reads as markup.
    /// </summary>
    /// <param name = "_text">The leading content.</param>
    /// <returns>true when a markup construct appears in the header window.</returns>
    private static boolean looksLikeMarkup(str _text)
    {
        int limit = strLen(_text) < FOSecureContentConstants::HeaderSearchWindow
            ? strLen(_text)
            : FOSecureContentConstants::HeaderSearchWindow;
        str window = subStr(_text, 1, limit);

        return FOSecureContentWindow::indexOfOrdinal(window, '<script') >= 0
            || FOSecureContentWindow::indexOfOrdinal(window, '<html') >= 0
            || FOSecureContentWindow::indexOfOrdinal(window, '<!doctype html') >= 0
            || FOSecureContentWindow::indexOfOrdinal(window, '<svg') >= 0
            || FOSecureContentWindow::indexOfOrdinal(window, '<iframe') >= 0;
    }

    /// <summary>
    /// Inflates compressed object streams and scans what comes out.
    /// </summary>
    /// <param name = "_window">The content, for the raw bytes.</param>
    /// <param name = "_text">The same content as text, for locating streams.</param>
    /// <param name = "_seed">Findings already collected.</param>
    /// <returns>The findings, including those seeded.</returns>
    public static FOSecureContentFindings scanObjectStreams(
        FOSecureContentWindow   _window,
        str                     _text,
        FOSecureContentFindings _seed)
    {
        FOSecureContentFindings findings = _seed;
        container     ranges = FOSecureContentInspectorPdf::streamRanges(_text);
        container     inflated;
        System.Byte[] slice;
        str           dictionary;
        str           inflatedText;
        int           i;
        int           streamAt;
        int           endAt;
        int           dictStart;
        int           dataStart;
        int           dataLength;
        int           skip;
        int           streams;
        int64         totalInflated;

        for (i = 1;
        i + 1 <= conLen(ranges) && streams < FOSecureContentInspectorPdf::MaxInflatedStreams;
        i += 2)
        {
            streamAt = conPeek(ranges, i);
            endAt    = conPeek(ranges, i + 1);

            dictStart = streamAt > FOSecureContentInspectorPdf::DictionaryLookBack
                ? streamAt - FOSecureContentInspectorPdf::DictionaryLookBack
                : 1;
            dictionary = subStr(_text, dictStart, streamAt - dictStart);

            if (FOSecureContentWindow::indexOfOrdinal(dictionary, '/ObjStm', 0, true) < 0
                || FOSecureContentWindow::indexOfOrdinal(dictionary, '/FlateDecode', 0, true) < 0)
            {
                continue;
            }

            // The keyword is followed by CRLF or a bare LF; a bare CR is not permitted.
            dataStart = streamAt + FOSecureContentInspectorPdf::StreamKeywordLength;

            if (char2Num(_text, dataStart) == FOSecureContentConstants::CarriageReturn
                && char2Num(_text, dataStart + 1) == FOSecureContentConstants::LineFeed)
            {
                dataStart += 2;
            }
            else if (char2Num(_text, dataStart) == FOSecureContentConstants::LineFeed)
            {
                dataStart += 1;
            }

            dataLength = endAt - dataStart;

            if (dataLength <= 2)
            {
                continue;
            }

            // A PDF stream is zlib wrapped; a ZIP entry would not be. Detect, then skip.
            skip = FOSecureDeflate::zlibHeaderLength(
                _window.byteAt(dataStart - 1),
                _window.byteAt(dataStart));

            if (skip < 0)
            {
                continue;
            }

            slice = _window.bytes(dataStart - 1 + skip, dataLength - skip);

            if (slice == null)
            {
                continue;
            }

            streams++;
            inflated = FOSecureDeflate::inflate(slice, dataLength - skip);

            if (!FOSecureDeflate::succeeded(inflated))
            {
                continue;
            }

            inflatedText   = FOSecureDeflate::textOf(inflated);
            totalInflated += strLen(inflatedText);
            findings       = FOSecureContentInspectorPdf::scanTokens(inflatedText, findings);

            if (totalInflated > FOSecureContentInspectorPdf::MaxInflatedPerFile)
            {
                break;
            }
        }

        return findings;
    }

    /// <summary>
    /// Confirms a PDF and reports what it carries.
    /// </summary>
    /// <param name = "_window">The content to inspect.</param>
    /// <param name = "_claimedExtension">The extension the file claims, normalized.</param>
    /// <returns>What was concluded. Never null, and never throws.</returns>
    public FOSecureContentInspection inspect(FOSecureContentWindow _window, str _claimedExtension)
    {
        FOSecureContentInspection result   = FOSecureContentInspection::inconclusive();
        FOSecureContentFindings   findings = FOSecureContentFindings::empty();
        str     headText;
        int     offset;
        boolean hasTrailer;

        if (!this.canInspect(_window))
        {
            return result;
        }

        try
        {
            headText = _window.textAt(0, _window.headLength());
            offset   = FOSecureContentInspectorPdf::headerOffset(headText);

            // Classified as a PDF but carrying no header in the window readers themselves scan.
            if (offset == FOSecureContentConstants::NotFound)
            {
                return result;
            }

            result   = result.withRefinedType('pdf', 'Portable Document Format');
            findings = FOSecureContentInspectorPdf::scanTokens(headText, findings);
            findings = FOSecureContentInspectorPdf::scanObjectStreams(_window, headText, findings);

            // Recorded, not rated: a few bytes of leading whitespace are ordinary.
            if (offset > FOSecureContentInspectorPdf::HeaderOffsetTolerance)
            {
                findings = findings.with(FOSecureContentFinding::construct(
                    FOSecureActiveContentKind::None,
                    FOSecureContentConstants::PdfHeaderOffsetEvidence,
                    offset));
            }

            if (offset == 0 && FOSecureContentInspectorPdf::looksLikeMarkup(headText))
            {
                findings = findings.with(FOSecureContentFinding::construct(
                    FOSecureActiveContentKind::Polyglot,
                    FOSecureContentConstants::PolyglotEvidence));
            }

            hasTrailer = _window.isTruncated()
                ? _window.lastIndexOfInTail('%%EOF', true) >= 0
                : FOSecureContentWindow::indexOfOrdinal(headText, '%%EOF', 0, true) >= 0;

            // Almost always a truncated upload rather than an attack, so no severity.
            if (!hasTrailer)
            {
                findings = findings.with(FOSecureContentFinding::construct(
                    FOSecureActiveContentKind::None,
                    FOSecureContentConstants::PdfTrailerMissingEvidence));
            }

            // Strings and streams are ciphertext, so finding nothing proves nothing.
            if (FOSecureContentWindow::indexOfOrdinal(headText, '/Encrypt', 0, true) >= 0)
            {
                findings = findings.with(FOSecureContentFinding::construct(
                    FOSecureActiveContentKind::None,
                    FOSecureContentConstants::PdfEncryptedEvidence));

                result = result.withUnassessable();
            }

            result = result.withFindings(findings);

            if (_window.isTruncated())
            {
                result = result.withUnassessable();
            }
        }
        catch (Exception::CLRError)
        {
            exceptionTextFallThrough();
        }
        catch (Exception::Error)
        {
            exceptionTextFallThrough();
        }

        return result;
    }

}